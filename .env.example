# Origin of the API server. Leave empty for local development — Vite proxies
# /api to http://localhost:4000 instead (see vite.config.js).
# In production set this to the deployed API, with no trailing slash:
#   VITE_API_URL=https://your-api.onrender.com
VITE_API_URL=

# Supabase — the same project the API uses. Project URL and the publishable
# key ("anon" on older projects), from Project Settings in the dashboard.
# The publishable key is meant to be public. Never put the secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
